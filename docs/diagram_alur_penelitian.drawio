        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" value="&lt;b&gt;DIAGRAM ALUR PENELITIAN&lt;/b&gt;&lt;br&gt;Sistem Arsip Digital dengan OCR dan Klasifikasi Dokumen Berbasis AI&lt;br&gt;(Studi Kasus: RRI Banjarmasin)" vertex="1">

        <mxCell id="node2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=5;fontSize=11;" value="&lt;b&gt;Studi Literatur&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;- Kearsipan dan Jadwal Retensi Arsip (JRA)&lt;br&gt;- Optical Character Recognition (OCR) dan Tesseract&lt;br&gt;- Preprocessing Citra: Grayscale, Upscale&lt;br&gt;- Text Cleaning dan Post-processing OCR&lt;br&gt;- TF-IDF (Word + Char N-gram) dan Logistic Regression&lt;br&gt;- Laravel, React, Inertia.js, FastAPI" vertex="1">
          <mxGeometry height="120" width="500" x="334.5" y="250" as="geometry" />

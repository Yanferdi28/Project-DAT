        <mxCell id="node1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=5;fontSize=11;" value="&lt;b&gt;Identifikasi Masalah&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;- Pengelolaan arsip RRI Banjarmasin masih manual&lt;br&gt;- Pencarian dokumen membutuhkan waktu lama&lt;br&gt;- Tidak ada klasifikasi otomatis dokumen arsip&lt;br&gt;- Kebutuhan digitalisasi arsip" vertex="1">
